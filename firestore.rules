rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return isSignedIn() &&
             request.auth.token.email != null &&
             request.auth.token.email == 'november112561@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShareCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 16 && code.matches('^[A-Z0-9]+$');
    }

    function isOptionalBase64(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500));
    }

    function isOptionalId(data, key) {
      return !(key in data) || data[key] == null || (data[key] is string && isValidId(data[key]));
    }

    function isValidPublicProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 36 &&
             (!('usernameLower' in data) || (data.usernameLower is string && data.usernameLower.size() >= 1 && data.usernameLower.size() <= 36)) &&
             data.bio is string && data.bio.size() <= 220 &&
             isOptionalBase64(data, 'avatarBase64', 70000) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('adminRole' in data) || data.adminRole is bool) &&
             (!('verifiedRole' in data) || data.verifiedRole is bool) &&
             isOptionalId(data, 'equippedFrameId') &&
             isOptionalId(data, 'equippedNameTagId') &&
             isOptionalId(data, 'equippedVerificationIconId');
    }

    function isValidOwnedEquip(userId, key) {
      return !(key in incoming()) ||
             incoming()[key] == null ||
             (
               incoming()[key] is string &&
               isValidId(incoming()[key]) &&
               (
                 (key in existing() && existing()[key] == incoming()[key]) ||
                 exists(/databases/$(database)/documents/public_profiles/$(userId)/owned_items/$(incoming()[key]))
               )
             );
    }

    function isValidCosmeticItem(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
             data.description is string && data.description.size() <= 220 &&
             data.type in ['FRAME', 'NAME_TAG', 'VERIFICATION_ICON'] &&
             data.availability in ['FREE_SHOP', 'EXCLUSIVE'] &&
             data.primaryColorHex is int &&
             data.secondaryColorHex is int &&
             data.textColorHex is int &&
             data.borderWidthDp is number && data.borderWidthDp >= 0.5 && data.borderWidthDp <= 8.0 &&
             data.tagText is string && data.tagText.size() <= 24 &&
             data.iconPreset is string && data.iconPreset.size() <= 32 &&
             isOptionalBase64(data, 'imageBase64', 65000) &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128;
    }

    function isValidUserLayout(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.gameTitle is string && data.gameTitle.size() >= 1 && data.gameTitle.size() <= 100 &&
             data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 32 &&
             data.globalOpacity is number && data.globalOpacity >= 0.2 && data.globalOpacity <= 1.0 &&
             data.gridSnap is bool &&
             data.active is bool &&
             data.clientUpdatedAt is int && data.clientUpdatedAt >= 0 &&
             data.controls is list && data.controls.size() <= 40 &&
             (data.controls.size() == 0 || data.controls[0] is map);
    }

    function isValidSharedLayout(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.gameTitle is string && data.gameTitle.size() >= 1 && data.gameTitle.size() <= 100 &&
             data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 32 &&
             data.globalOpacity is number && data.globalOpacity >= 0.2 && data.globalOpacity <= 1.0 &&
             data.gridSnap is bool &&
             data.controls is list && data.controls.size() <= 40 &&
             (data.controls.size() == 0 || data.controls[0] is map);
    }

    function isValidUserSettings(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.gameFilterJson is string && data.gameFilterJson.size() <= 160000 &&
             data.crosshairJson is string && data.crosshairJson.size() <= 160000 &&
             data.colorSchemeJson is string && data.colorSchemeJson.size() <= 8000 &&
             data.fontConfigJson is string && data.fontConfigJson.size() <= 4000 &&
             data.floatingBubbleJson is string && data.floatingBubbleJson.size() <= 4000 &&
             data.darkTheme is bool &&
             data.clientUpdatedAt is int && data.clientUpdatedAt >= 0;
    }

    function isValidButtonTheme(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
             isOptionalBase64(data, 'authorAvatarBase64', 70000) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.gameTag is string && data.gameTag.size() >= 1 && data.gameTag.size() <= 50 &&
             data.description is string && data.description.size() <= 300 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 30 &&
             data.themeJson is string && data.themeJson.size() >= 2 && data.themeJson.size() <= 720000 &&
             data.published is bool &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.favoritesCount is int && data.favoritesCount >= 0 &&
             data.downloadsCount is int && data.downloadsCount >= 0 &&
             data.commentsCount is int && data.commentsCount >= 0;
    }

    function isValidWorkshopComment(data) {
      return data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
             isOptionalBase64(data, 'authorAvatarBase64', 70000) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 400;
    }

    function isValidProfileClip(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
             isOptionalBase64(data, 'authorAvatarBase64', 70000) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.gameTag is string && data.gameTag.size() <= 50 &&
             data.caption is string && data.caption.size() <= 260 &&
             data.durationMs is int && data.durationMs >= 0 &&
             isOptionalBase64(data, 'thumbnailBase64', 100000) &&
             data.storyboardFrames is list && data.storyboardFrames.size() <= 6 &&
             (!('localMediaUri' in data) || data.localMediaUri == null || (data.localMediaUri is string && data.localMediaUri.size() <= 300)) &&
             data.likesCount is int && data.likesCount >= 0;
    }

    function isValidCommunityPost(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
             isOptionalBase64(data, 'authorAvatarBase64', 70000) &&
             data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 40 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 1500 &&
             isOptionalBase64(data, 'imageBase64', 130000) &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.commentsCount is int && data.commentsCount >= 0;
    }

    function isSingleCounterDelta(field, allowDecrement) {
      let diff = incoming()[field] - existing()[field];
      return incoming().diff(existing()).affectedKeys().hasOnly([field]) &&
             incoming()[field] is int &&
             incoming()[field] >= 0 &&
             (diff == 1 || (allowDecrement && diff == -1));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserAccount(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /layouts/{layoutId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(layoutId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(layoutId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'gameTitle', 'genre',
                           'globalOpacity', 'gridSnap', 'active',
                           'controls', 'clientUpdatedAt', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'gameTitle', 'genre',
                           'globalOpacity', 'gridSnap', 'active',
                           'controls', 'clientUpdatedAt', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidUserLayout(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(layoutId) &&
                         request.auth.uid == userId &&
                         isValidUserLayout(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'gameTitle', 'genre', 'globalOpacity',
                           'gridSnap', 'active', 'controls', 'clientUpdatedAt', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(layoutId) && request.auth.uid == userId;
      }

      match /settings/{settingId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(settingId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(settingId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'gameFilterJson', 'crosshairJson', 'colorSchemeJson',
                           'fontConfigJson', 'floatingBubbleJson', 'darkTheme',
                           'clientUpdatedAt', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'gameFilterJson', 'crosshairJson', 'colorSchemeJson',
                           'fontConfigJson', 'floatingBubbleJson', 'darkTheme',
                           'clientUpdatedAt', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidUserSettings(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(settingId) &&
                         request.auth.uid == userId &&
                         isValidUserSettings(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'gameFilterJson', 'crosshairJson', 'colorSchemeJson',
                           'fontConfigJson', 'floatingBubbleJson', 'darkTheme',
                           'clientUpdatedAt', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(settingId) && request.auth.uid == userId;
      }

      match /favorite_themes/{themeId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(themeId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(themeId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().themeId == themeId &&
                         incoming().keys().hasAll(['userId', 'themeId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'themeId', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time;

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(themeId) && request.auth.uid == userId;
      }
    }

    match /public_profiles/{userId} {
      // Any signed-in user can view another creator's public profile by UID;
      // listing/searching profiles is strictly restricted to the primary admin.
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isPrimaryAdmin() && request.query.limit <= 50;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'bio', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'username', 'usernameLower', 'bio',
                         'avatarBase64', 'avatarUrl', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidPublicProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidPublicProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (
                           request.auth.uid == userId &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'username', 'usernameLower', 'bio', 'avatarBase64', 'avatarUrl',
                             'equippedFrameId', 'equippedNameTagId', 'equippedVerificationIconId',
                             'updatedAt'
                           ]) &&
                           isValidOwnedEquip(userId, 'equippedFrameId') &&
                           isValidOwnedEquip(userId, 'equippedNameTagId') &&
                           isValidOwnedEquip(userId, 'equippedVerificationIconId')
                         ) ||
                         (
                           isPrimaryAdmin() &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'adminRole', 'verifiedRole',
                             'equippedFrameId', 'equippedNameTagId', 'equippedVerificationIconId',
                             'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /owned_items/{itemId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(itemId) &&
                      (request.auth.uid == userId || isPrimaryAdmin());
        allow list: if isSignedIn() && isValidId(userId) &&
                       (request.auth.uid == userId || isPrimaryAdmin()) &&
                       request.query.limit <= 100;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(itemId) &&
                         incoming().itemId == itemId &&
                         incoming().keys().hasAll(['itemId', 'grantedByAdmin', 'grantedAt']) &&
                         incoming().keys().hasOnly(['itemId', 'grantedByAdmin', 'grantedAt']) &&
                         incoming().grantedByAdmin is bool &&
                         incoming().grantedAt is timestamp && incoming().grantedAt <= request.time &&
                         (
                           (
                             isPrimaryAdmin() &&
                             exists(/databases/$(database)/documents/cosmetic_items/$(itemId))
                           ) ||
                           (
                             request.auth.uid == userId &&
                             incoming().grantedByAdmin == false &&
                             get(/databases/$(database)/documents/cosmetic_items/$(itemId)).data.availability == 'FREE_SHOP'
                           )
                         );

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(itemId) &&
                         (isPrimaryAdmin() || request.auth.uid == userId);
      }
    }

    match /cosmetic_items/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId);
      allow list: if isSignedIn() && request.query.limit <= 100;

      allow create: if isPrimaryAdmin() &&
                       isValidId(itemId) &&
                       incoming().createdByUid == request.auth.uid &&
                       incoming().keys().hasAll([
                         'name', 'description', 'type', 'availability',
                         'primaryColorHex', 'secondaryColorHex', 'textColorHex',
                         'borderWidthDp', 'tagText', 'iconPreset', 'createdByUid',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'name', 'description', 'type', 'availability',
                         'primaryColorHex', 'secondaryColorHex', 'textColorHex',
                         'borderWidthDp', 'tagText', 'iconPreset', 'imageBase64',
                         'createdByUid', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidCosmeticItem(incoming());

      allow update: if isPrimaryAdmin() &&
                       isValidId(itemId) &&
                       isValidCosmeticItem(incoming()) &&
                       incoming().createdByUid == existing().createdByUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'description', 'type', 'availability',
                         'primaryColorHex', 'secondaryColorHex', 'textColorHex',
                         'borderWidthDp', 'tagText', 'iconPreset', 'imageBase64',
                         'updatedAt'
                       ]);

      allow delete: if isPrimaryAdmin() && isValidId(itemId);
    }

    match /shared_layouts/{shareCode} {
      allow get: if isSignedIn() &&
                    isValidShareCode(shareCode) &&
                    (resource == null || existing().ownerId == request.auth.uid || existing().expiresAt > request.time);

      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidShareCode(shareCode) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'ownerId', 'authorName', 'name', 'gameTitle', 'genre',
                         'globalOpacity', 'gridSnap', 'controls', 'createdAt', 'expiresAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'authorName', 'name', 'gameTitle', 'genre',
                         'globalOpacity', 'gridSnap', 'controls', 'createdAt', 'expiresAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().expiresAt is timestamp &&
                       incoming().expiresAt > request.time &&
                       incoming().expiresAt <= request.time + duration.value(6, 'm') &&
                       isValidSharedLayout(incoming());

      allow update: if false;

      allow delete: if isSignedIn() && isValidShareCode(shareCode) && existing().ownerId == request.auth.uid;
    }

    match /button_themes/{themeId} {
      allow get: if isSignedIn() &&
                    isValidId(themeId) &&
                    (resource == null || existing().published == true || existing().ownerId == request.auth.uid);

      allow list: if isSignedIn() &&
                     request.query.limit <= 50 &&
                     (existing().published == true || existing().ownerId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(themeId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'ownerId', 'authorName', 'name', 'gameTag', 'description',
                         'category', 'themeJson', 'published', 'likesCount',
                         'favoritesCount', 'downloadsCount', 'commentsCount',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'authorName', 'authorAvatarBase64', 'name', 'gameTag',
                         'description', 'category', 'themeJson', 'published', 'likesCount',
                         'favoritesCount', 'downloadsCount', 'commentsCount',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().likesCount == 0 &&
                       incoming().favoritesCount == 0 &&
                       incoming().downloadsCount == 0 &&
                       incoming().commentsCount == 0 &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidButtonTheme(incoming());

      allow update: if isSignedIn() &&
                       isValidId(themeId) &&
                       isValidButtonTheme(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           existing().ownerId == request.auth.uid &&
                           incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'authorName', 'authorAvatarBase64', 'name', 'gameTag',
                             'description', 'category', 'themeJson', 'published', 'updatedAt'
                           ])
                         ) ||
                         (
                           existing().published == true &&
                           (
                             isSingleCounterDelta('likesCount', true) ||
                             isSingleCounterDelta('favoritesCount', true) ||
                             isSingleCounterDelta('downloadsCount', false) ||
                             isSingleCounterDelta('commentsCount', true)
                           )
                         )
                       );

      allow delete: if isSignedIn() && isValidId(themeId) && existing().ownerId == request.auth.uid;

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(themeId) && isValidId(userId) && request.auth.uid == userId;
        allow list: if false;

        allow create: if isSignedIn() &&
                         isValidId(themeId) &&
                         isValidId(userId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time;

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(themeId) && isValidId(userId) && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(themeId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(themeId) && request.query.limit <= 50;

        allow create: if isSignedIn() &&
                         isValidId(themeId) &&
                         isValidId(commentId) &&
                         incoming().authorUid == request.auth.uid &&
                         incoming().keys().hasAll(['authorUid', 'authorName', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['authorUid', 'authorName', 'authorAvatarBase64', 'text', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidWorkshopComment(incoming());

        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(themeId) &&
                         isValidId(commentId) &&
                         (
                           existing().authorUid == request.auth.uid ||
                           get(/databases/$(database)/documents/button_themes/$(themeId)).data.ownerId == request.auth.uid
                         );
      }
    }

    match /profile_clips/{clipId} {
      allow get: if isSignedIn() && isValidId(clipId);
      allow list: if isSignedIn() && request.query.limit <= 30;

      allow create: if isSignedIn() &&
                       isValidId(clipId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'ownerId', 'authorName', 'title', 'gameTag', 'caption',
                         'durationMs', 'storyboardFrames', 'likesCount', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'authorName', 'authorAvatarBase64', 'title', 'gameTag',
                         'caption', 'durationMs', 'thumbnailBase64', 'storyboardFrames',
                         'localMediaUri', 'likesCount', 'createdAt'
                       ]) &&
                       incoming().likesCount == 0 &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidProfileClip(incoming());

      allow update: if isSignedIn() &&
                       isValidId(clipId) &&
                       isValidProfileClip(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           existing().ownerId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'gameTag', 'caption', 'authorName', 'authorAvatarBase64'])
                         ) ||
                         isSingleCounterDelta('likesCount', true)
                       );

      allow delete: if isSignedIn() && isValidId(clipId) && existing().ownerId == request.auth.uid;

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(clipId) && isValidId(userId) && request.auth.uid == userId;
        allow list: if false;

        allow create: if isSignedIn() &&
                         isValidId(clipId) &&
                         isValidId(userId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time;

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(clipId) && isValidId(userId) && request.auth.uid == userId;
      }
    }

    match /community_posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn() && request.query.limit <= 40;

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'ownerId', 'authorName', 'topic', 'title', 'body',
                         'likesCount', 'commentsCount', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'authorName', 'authorAvatarBase64', 'topic', 'title',
                         'body', 'imageBase64', 'likesCount', 'commentsCount', 'createdAt'
                       ]) &&
                       incoming().likesCount == 0 &&
                       incoming().commentsCount == 0 &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidCommunityPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidCommunityPost(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           existing().ownerId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'title', 'body', 'authorName', 'authorAvatarBase64'])
                         ) ||
                         isSingleCounterDelta('likesCount', true) ||
                         isSingleCounterDelta('commentsCount', true)
                       );

      allow delete: if isSignedIn() && isValidId(postId) && existing().ownerId == request.auth.uid;

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(userId) && request.auth.uid == userId;
        allow list: if false;

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(userId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time;

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(postId) && isValidId(userId) && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(postId) && request.query.limit <= 50;

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().authorUid == request.auth.uid &&
                         incoming().keys().hasAll(['authorUid', 'authorName', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['authorUid', 'authorName', 'authorAvatarBase64', 'text', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidWorkshopComment(incoming());

        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         (
                           existing().authorUid == request.auth.uid ||
                           get(/databases/$(database)/documents/community_posts/$(postId)).data.ownerId == request.auth.uid
                         );
      }
    }
  }
}
