{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated NexusPad cloud user profile.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner."
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in account settings and shared layout attribution."
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional Google profile avatar URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "displayName",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public community profile containing custom username, bio, and uploaded avatar (zero PII).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "bio": { "type": "string" },
        "avatarBase64": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "bio", "createdAt", "updatedAt"]
    },
    "UserLayout": {
      "title": "UserLayout",
      "description": "Cloud-synced controller and keyboard layout belonging to a specific user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "gameTitle": { "type": "string" },
        "genre": { "type": "string" },
        "globalOpacity": { "type": "number" },
        "gridSnap": { "type": "boolean" },
        "active": { "type": "boolean" },
        "controls": { "type": "array" },
        "clientUpdatedAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "name", "gameTitle", "genre", "globalOpacity",
        "gridSnap", "active", "controls", "clientUpdatedAt", "createdAt", "updatedAt"
      ]
    },
    "SharedLayout": {
      "title": "SharedLayout",
      "description": "Temporary 5-minute share code snapshot allowing friends to import a copy of a layout.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "authorName": { "type": "string" },
        "name": { "type": "string" },
        "gameTitle": { "type": "string" },
        "genre": { "type": "string" },
        "globalOpacity": { "type": "number" },
        "gridSnap": { "type": "boolean" },
        "controls": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "authorName", "name", "gameTitle", "genre",
        "globalOpacity", "gridSnap", "controls", "createdAt", "expiresAt"
      ]
    },
    "UserSettingsBackup": {
      "title": "UserSettingsBackup",
      "description": "Cloud-synced Freestyle Filters, Crosshair, App Theme, Font preset, and Floating Bubble preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "gameFilterJson": { "type": "string" },
        "crosshairJson": { "type": "string" },
        "colorSchemeJson": { "type": "string" },
        "fontConfigJson": { "type": "string" },
        "floatingBubbleJson": { "type": "string" },
        "darkTheme": { "type": "boolean" },
        "clientUpdatedAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "gameFilterJson", "crosshairJson", "colorSchemeJson",
        "fontConfigJson", "floatingBubbleJson", "darkTheme",
        "clientUpdatedAt", "createdAt", "updatedAt"
      ]
    },
    "FavoriteTheme": {
      "title": "FavoriteTheme",
      "description": "Owner-scoped bookmark referencing a Button Theme Workshop preset.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "themeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "themeId", "createdAt"]
    },
    "ButtonTheme": {
      "title": "ButtonTheme",
      "description": "Community-created custom button theme preset (e.g., DBD style) published to the Theme Workshop.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatarBase64": { "type": "string" },
        "name": { "type": "string" },
        "gameTag": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "themeJson": { "type": "string" },
        "published": { "type": "boolean" },
        "likesCount": { "type": "integer" },
        "favoritesCount": { "type": "integer" },
        "downloadsCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "authorName", "name", "gameTag", "description", "category",
        "themeJson", "published", "likesCount", "favoritesCount", "downloadsCount",
        "commentsCount", "createdAt", "updatedAt"
      ]
    },
    "LikeRecord": {
      "title": "LikeRecord",
      "description": "Per-user like marker document.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "WorkshopComment": {
      "title": "WorkshopComment",
      "description": "User comment on a button theme or community discussion post.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatarBase64": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "authorName", "text", "createdAt"]
    },
    "ProfileClip": {
      "title": "ProfileClip",
      "description": "Gameplay clip recorded in the app and posted from Gallery onto a user's profile.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatarBase64": { "type": "string" },
        "title": { "type": "string" },
        "gameTag": { "type": "string" },
        "caption": { "type": "string" },
        "durationMs": { "type": "integer" },
        "thumbnailBase64": { "type": "string" },
        "storyboardFrames": { "type": "array" },
        "localMediaUri": { "type": "string" },
        "likesCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "authorName", "title", "gameTag", "caption",
        "durationMs", "storyboardFrames", "likesCount", "createdAt"
      ]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Conversation and topic post displayed on user profiles and community discussions.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatarBase64": { "type": "string" },
        "topic": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "imageBase64": { "type": "string" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "authorName", "topic", "title", "body",
        "likesCount", "commentsCount", "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account profile."
    },
    "/users/{userId}/layouts/{layoutId}": {
      "schema": { "$ref": "#/entities/UserLayout" },
      "description": "User-owned cloud-backed layouts synced across app updates."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSettingsBackup" },
      "description": "User-owned cloud-backed Freestyle filters, crosshair, and visual theme settings."
    },
    "/users/{userId}/favorite_themes/{themeId}": {
      "schema": { "$ref": "#/entities/FavoriteTheme" },
      "description": "User-owned favorited Button Theme Workshop IDs."
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public community profiles with custom username, bio, and uploaded avatar."
    },
    "/shared_layouts/{shareCode}": {
      "schema": { "$ref": "#/entities/SharedLayout" },
      "description": "5-minute expiring share codes for friend-to-friend layout sharing."
    },
    "/button_themes/{themeId}": {
      "schema": { "$ref": "#/entities/ButtonTheme" },
      "description": "Published custom button theme presets in the Button Theme Workshop."
    },
    "/button_themes/{themeId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/LikeRecord" },
      "description": "Per-user like records for button themes."
    },
    "/button_themes/{themeId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/WorkshopComment" },
      "description": "Community comments on button themes."
    },
    "/profile_clips/{clipId}": {
      "schema": { "$ref": "#/entities/ProfileClip" },
      "description": "Recorded gameplay clips posted from Gallery onto user profiles."
    },
    "/profile_clips/{clipId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/LikeRecord" },
      "description": "Per-user like records for profile clips."
    },
    "/community_posts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "User topic conversations and discussion posts."
    },
    "/community_posts/{postId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/LikeRecord" },
      "description": "Per-user like records for community posts."
    },
    "/community_posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/WorkshopComment" },
      "description": "Replies and comments on community posts."
    }
  }
}
